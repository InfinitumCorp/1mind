# 1MIND configuration. Copy to .env (git-ignored).

# Access token for the console. If unset, one is generated into .1mind-token on first start.
# ONEMIND_TOKEN=

# GitHub owner whose repos 1MIND controls (default: the account `gh` is logged in as).
# ONEMIND_GH_OWNER=InfinitumCorp

# Ports (bound to 127.0.0.1 only)
# PORT=4400
# PREVIEW_PORT=4401

# Conjure: live Claude. Without a key Conjure runs on its offline mock provider.
# ANTHROPIC_API_KEY=
# CONJURE_MODEL=claude-opus-5-5

# @scalvs / @scalus in the Conjure intent box: the SCALVS agent on your OpenClaw gateway. Off until both are set.
# OPENCLAW_GATEWAY_URL=
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT=openclaw
# @conjure <question>: a Conjure prediction-model forecast. Off until both are set.
# CONJURE_URL=
# CONJURE_PRODUCT_KEY=
