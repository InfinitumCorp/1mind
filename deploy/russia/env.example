# /etc/1mind/env on the server: root-owned, mode 640, group onemind. Never commit the real file.

# Public origins (HTTPS turns on Secure cookies).
ONEMIND_PUBLIC_URL=https://1mind-ru.infinitumcorporation.ai
ONEMIND_PREVIEW_URL=https://1mind-ru-preview.infinitumcorporation.ai

# Cookie-signing secret. install.sh generates it; nobody types it.
ONEMIND_TOKEN=

# Sign-in: Cumulus ID. Only these Cumulus IDs (cid, username, handle or email) get in.
CID_CLIENT_ID=1mind
CID_OWNERS=
# A Cumulus ID mirror, if id.cumuluscloud.app ever stops loading in Russia:
# CID_ISSUER=

# GitHub owner whose repos 1MIND manages (gh must be signed in as the onemind user).
ONEMIND_GH_OWNER=InfinitumCorp

# Never add ANTHROPIC_API_KEY on a server in Russia. Conjure runs on its offline mock here.
